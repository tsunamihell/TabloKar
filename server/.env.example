DATABASE_URL="file:./tablokar.db"
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
PORT=5000
# Leave empty for the same-origin Vite proxy. Set exact browser origins when needed.
CORS_ORIGINS=
# Needed only to create the first admin. Existing passwords are never overwritten.
ADMIN_PASSWORD=
# Optional: creates an installer only when explicitly configured.
INSTALLER_PASSWORD=
